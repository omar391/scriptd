{
  "$defs": {
    "AllCondition": {
      "additionalProperties": false,
      "description": "A non-empty recursive Boolean condition tree.",
      "properties": {
        "all": {
          "items": {
            "$ref": "#/$defs/ConditionDef"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "all"
      ],
      "type": "object"
    },
    "AnyCondition": {
      "additionalProperties": false,
      "description": "A non-empty recursive Boolean condition tree.",
      "properties": {
        "any": {
          "items": {
            "$ref": "#/$defs/ConditionDef"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "any"
      ],
      "type": "object"
    },
    "ConditionDef": {
      "anyOf": [
        {
          "$ref": "#/$defs/AllCondition"
        },
        {
          "$ref": "#/$defs/AnyCondition"
        },
        {
          "$ref": "#/$defs/ScheduleLeaf"
        },
        {
          "$ref": "#/$defs/TimeWindowLeaf"
        },
        {
          "$ref": "#/$defs/WifiPowerLeaf"
        },
        {
          "$ref": "#/$defs/WifiSsidLeaf"
        },
        {
          "$ref": "#/$defs/ProcessNetworkLeaf"
        }
      ]
    },
    "CronSchedule": {
      "additionalProperties": false,
      "properties": {
        "cron": {
          "$ref": "#/$defs/StringOrStringListSchema"
        },
        "timezone": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "cron"
      ],
      "type": "object"
    },
    "DailyAtSchedule": {
      "additionalProperties": false,
      "properties": {
        "daily_at": {
          "$ref": "#/$defs/StringOrStringListSchema"
        },
        "timezone": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "daily_at"
      ],
      "type": "object"
    },
    "EveryHoursSchedule": {
      "additionalProperties": false,
      "properties": {
        "every_hours": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "timezone": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "every_hours"
      ],
      "type": "object"
    },
    "EveryMinutesSchedule": {
      "additionalProperties": false,
      "properties": {
        "every_minutes": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "timezone": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "every_minutes"
      ],
      "type": "object"
    },
    "EverySecondsSchedule": {
      "additionalProperties": false,
      "properties": {
        "every_seconds": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "timezone": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "every_seconds"
      ],
      "type": "object"
    },
    "FirePolicy": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "every_match",
              "type": "string"
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "after": {
              "$ref": "#/$defs/MatchRequirement"
            },
            "mode": {
              "const": "latched",
              "type": "string"
            },
            "reset": {
              "$ref": "#/$defs/ResetPolicy"
            }
          },
          "required": [
            "mode",
            "after",
            "reset"
          ],
          "type": "object"
        }
      ]
    },
    "MatchRequirement": {
      "additionalProperties": false,
      "properties": {
        "consecutive_matches": {
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "minimum_seconds": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "consecutive_matches",
        "minimum_seconds"
      ],
      "type": "object"
    },
    "NetworkAggregation": {
      "enum": [
        "sum"
      ],
      "type": "string"
    },
    "ProcessNetworkCondition": {
      "additionalProperties": false,
      "properties": {
        "aggregation": {
          "$ref": "#/$defs/NetworkAggregation"
        },
        "applications": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "at_least_bytes_per_second": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "applications",
        "aggregation",
        "at_least_bytes_per_second"
      ],
      "type": "object"
    },
    "ProcessNetworkLeaf": {
      "additionalProperties": false,
      "description": "An aggregate network-throughput condition for application bundles.",
      "properties": {
        "process_network": {
          "$ref": "#/$defs/ProcessNetworkCondition"
        }
      },
      "required": [
        "process_network"
      ],
      "type": "object"
    },
    "ResetPolicy": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "$ref": "#/$defs/MatchRequirement"
        },
        "when": {
          "$ref": "#/$defs/ConditionDef"
        }
      },
      "required": [
        "after",
        "when"
      ],
      "type": "object"
    },
    "ScheduleCondition": {
      "anyOf": [
        {
          "$ref": "#/$defs/EverySecondsSchedule"
        },
        {
          "$ref": "#/$defs/EveryMinutesSchedule"
        },
        {
          "$ref": "#/$defs/EveryHoursSchedule"
        },
        {
          "$ref": "#/$defs/DailyAtSchedule"
        },
        {
          "$ref": "#/$defs/CronSchedule"
        }
      ]
    },
    "ScheduleLeaf": {
      "additionalProperties": false,
      "description": "A schedule leaf that emits evaluation pulses.",
      "properties": {
        "schedule": {
          "$ref": "#/$defs/ScheduleCondition"
        }
      },
      "required": [
        "schedule"
      ],
      "type": "object"
    },
    "ScopedTriggerConfig": {
      "additionalProperties": false,
      "description": "A Boolean trigger scoped to its parent module.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "fire": {
          "$ref": "#/$defs/FirePolicy"
        },
        "when": {
          "$ref": "#/$defs/ConditionDef"
        }
      },
      "required": [
        "fire",
        "when"
      ],
      "type": "object"
    },
    "ServiceModuleConfig": {
      "additionalProperties": false,
      "description": "Enablement and trigger policy owned by one module.",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "triggers": {
          "additionalProperties": {
            "$ref": "#/$defs/ScopedTriggerConfig"
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "type": "object"
        }
      },
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "type": "object"
    },
    "ServiceModulePolicies": {
      "additionalProperties": false,
      "description": "The built-in module policy sections accepted by scriptd.",
      "properties": {
        "mbrew": {
          "anyOf": [
            {
              "$ref": "#/$defs/ServiceModuleConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "mcpu": {
          "anyOf": [
            {
              "$ref": "#/$defs/ServiceModuleConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "miwatch": {
          "anyOf": [
            {
              "$ref": "#/$defs/ServiceModuleConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "mwifi": {
          "anyOf": [
            {
              "$ref": "#/$defs/ServiceModuleConfig"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "ServiceSettings": {
      "additionalProperties": false,
      "description": "Shared daemon settings used by all modules.",
      "properties": {
        "label": {
          "minLength": 1,
          "type": "string"
        },
        "log_dir": {
          "minLength": 1,
          "type": "string"
        },
        "self_update_check_hours": {
          "default": 12,
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "watch": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "label",
        "log_dir"
      ],
      "type": "object"
    },
    "StringOrStringListSchema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      ]
    },
    "TimeWindowCondition": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$",
          "type": "string"
        },
        "start": {
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$",
          "type": "string"
        },
        "timezone": {
          "type": "string"
        },
        "weekdays": {
          "items": {
            "$ref": "#/$defs/WeekdayName"
          },
          "type": [
            "array",
            "null"
          ],
          "uniqueItems": true
        }
      },
      "required": [
        "timezone",
        "start",
        "end"
      ],
      "type": "object"
    },
    "TimeWindowLeaf": {
      "additionalProperties": false,
      "description": "A half-open local-time window, including overnight windows.",
      "properties": {
        "time_window": {
          "$ref": "#/$defs/TimeWindowCondition"
        }
      },
      "required": [
        "time_window"
      ],
      "type": "object"
    },
    "WeekdayName": {
      "enum": [
        "sun",
        "mon",
        "tue",
        "wed",
        "thu",
        "fri",
        "sat"
      ],
      "type": "string"
    },
    "WifiPowerCondition": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "$ref": "#/$defs/WifiPowerState"
        }
      },
      "required": [
        "state"
      ],
      "type": "object"
    },
    "WifiPowerLeaf": {
      "additionalProperties": false,
      "description": "A Wi-Fi power-state sensor condition.",
      "properties": {
        "wifi_power": {
          "$ref": "#/$defs/WifiPowerCondition"
        }
      },
      "required": [
        "wifi_power"
      ],
      "type": "object"
    },
    "WifiPowerState": {
      "enum": [
        "on",
        "off"
      ],
      "type": "string"
    },
    "WifiSsidCondition": {
      "additionalProperties": false,
      "properties": {
        "ssid": {
          "minLength": 1,
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/WifiSsidState"
        }
      },
      "required": [
        "ssid",
        "state"
      ],
      "type": "object"
    },
    "WifiSsidLeaf": {
      "additionalProperties": false,
      "description": "A connected or visible SSID sensor condition.",
      "properties": {
        "wifi_ssid": {
          "$ref": "#/$defs/WifiSsidCondition"
        }
      },
      "required": [
        "wifi_ssid"
      ],
      "type": "object"
    },
    "WifiSsidState": {
      "enum": [
        "connected",
        "disconnected",
        "available",
        "unavailable"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Validated scriptd configuration document. Generated from Rust types.",
  "properties": {
    "modules": {
      "$ref": "#/$defs/ServiceModulePolicies",
      "default": {}
    },
    "service": {
      "$ref": "#/$defs/ServiceSettings"
    },
    "version": {
      "const": 1,
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "version",
    "service"
  ],
  "title": "ServiceDocument",
  "type": "object"
}
